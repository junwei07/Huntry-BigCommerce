rules_version = '2';

// Deny everything to client SDKs. This app is server-only: it reads and writes
// Firestore through the Admin SDK (IAM-authenticated), which bypasses these rules,
// and no browser or mobile client talks to this database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
