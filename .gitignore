# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local sqlite credentials store
/data/*.sqlite*

# maplibre-gl worker files, copied from node_modules by
# scripts/copy-maplibre-worker.mjs at dev/build time
/public/huntry/maplibre-worker/*

# storefront bundle string, generated by scripts/build-storefront-script.mjs
/src/lib/huntry/storefront-script/**/*.generated.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local deployment secrets (keep ignored)
.open-next
.wrangler
.dev.vars*
!.dev.vars*.example
.secrets*
!.secrets.*.example

ARTIFACTS/*

tickets.md
migration.md
HBC-CHANGELOG.md
/huntry/
# Firebase
.firebase/
firebase-debug.log*
firestore-debug.log
ui-debug.log
*-adminsdk-*.json
firebase-export-*/
